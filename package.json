{
  "name": "mongolian-steppe",
  "version": "1.0.0",
  "description": "A PSX-style Mongolian town built with Three.js.",
  "private": true,
  "scripts": {
    "build": "npm run build:game && npm run build:character",
    "build:game": "esbuild src/main.js --bundle --format=iife --target=es2020 --minify --outfile=dist/bundle.js",
    "build:character": "esbuild src/characterOnly.js --bundle --format=iife --target=es2020 --minify --outfile=dist/character.js",
    "start": "esbuild src/main.js --bundle --format=iife --target=es2020 --sourcemap --outfile=dist/bundle.js --watch=forever --servedir=. --serve=127.0.0.1:5173 --footer:js=\"new EventSource('/esbuild').addEventListener('change', () => location.reload());\"",
    "start:character": "esbuild src/characterOnly.js --bundle --format=iife --target=es2020 --sourcemap --outfile=dist/character.js --watch=forever --servedir=. --serve=127.0.0.1:5174 --footer:js=\"new EventSource('/esbuild').addEventListener('change', () => location.reload());\"",
    "dev": "npm start",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build"
  },
  "keywords": [],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
